{
  "_comment": "Example Claude Code hook wiring for this harness. Copy the blocks you want into ~/.claude/settings.json and adjust the absolute paths to where you cloned this repo. Every hook here fails open: a bug in a hook never blocks real work.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node ~/.claude/hooks/bash-precheck.js", "timeout": 8000 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node ~/.claude/hooks/post-bash-combined.js", "timeout": 12000 }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node ~/.claude/hooks/watermark-strip.js", "timeout": 8000 },
          { "type": "command", "command": "node ~/.claude/hooks/anti-slop-guard.js", "timeout": 30000 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node ~/.claude/hooks/verified-claim-guard.js", "timeout": 8000 },
          { "type": "command", "command": "node ~/.claude/hooks/stop-render-audit.js", "timeout": 5000 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "_comment": "Optional. Auto-applies a voice profile to outbound messages. Point it at your own voices/voice.md (copy voices/voice.example.md).",
        "hooks": [
          { "type": "command", "command": "node ~/.claude/hooks/outbound-voice.js", "timeout": 3000 }
        ]
      }
    ]
  }
}
